<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--#########################################  Form view  #############################################-->
    <record id="view_confirm_order_form" model="ir.ui.view">
        <field name="name">Confirm.order.form</field>
        <field name="model">payment.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation">
                <sheet>
                    <div class="o_form_label" style="text-align:center; font-size:16px; padding:20px;">
                        Are you sure you want to complete with
                        <span style="color:red; font-weight:bold;">0 payment amount</span>?
                    </div>
                </sheet>

                <footer>
                    <button name="action_confirm"
                            string="Yes"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <!--####################################################################################################-->

</odoo>