<odoo>
    <record id="motorcycle_product_template_form_view" model="ir.ui.view">
        <field name="name">motorcycle.product.template.form.view</field>
        <field name="model">motorcycle.product.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_type"/>
                            <field name="reference"/>
                            <field name="quantity"/>
                        </group>

                        <group>
                            <field name="cost" widget="monetary"/>
                            <field name="price" widget="monetary"/>
                            <field name="whole_sale_price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="barcode" widget="barcode"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="motorcycle_product_template_tree_view" model="ir.ui.view">
        <field name="name">motorcycle.product.template.tree.view</field>
        <field name="model">motorcycle.product.template</field>
        <field name="arch" type="xml">
            <tree decoration-danger="quantity &lt; 2">
                <field name="image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="currency_id" invisible="1"/>
                <field name="product_type"/>
                <field name="reference"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="whole_sale_price"/>
                <field name="barcode" widget="barcode"/>
            </tree>
        </field>
    </record>

    <record id="motorcycle_product_kanban_view" model="ir.ui.view">
        <field name="name">motorcycle.product.kanban.view</field>
        <field name="model">motorcycle.product.template</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="image"/>
                <field name="name"/>
                <field name="cost"/>
                <field name="whole_sale_price"/>
                <field name="price"/>
                <field name="product_type"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div style="display: flex; gap: 15px; align-items: center;">
                                <div style="flex-shrink: 0;">
                                    <img class="oe_kanban_image"
                                         t-att-src="kanban_image('motorcycle.product.template', 'image', record.id.value)"
                                         t-att-alt="record.name.value"
                                         style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;"/>
                                </div>
                                <div style="flex: 1;">
                                    <div class="o_kanban_record_title">
                                        <strong> <field name="name"/> </strong>
                                    </div>
                                    <div> Product Type:<field name="product_type"/> </div>
                                    <div> Ref:<field name="reference"/> </div>
                                    <ul style="margin: 8px 0 0 0; padding-left: 15px;">
                                        <li> Price:<field name="price"/> </li>
                                        <li> Whole Sale Price:<field name="whole_sale_price"/></li>
                                        <li>Cost:<field name="cost"/></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="motorcycle_product_search_view" model="ir.ui.view">
        <field name="name">motorcycle.product.search.view</field>
        <field name="model">motorcycle.product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"
                       filter_domain="['|', '|',('name', 'ilike', self), ('reference', 'ilike', self), ('product_type', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_motorcycle_product_template_view" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">motorcycle.product.template</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first product !
            </p>
        </field>
    </record>
</odoo>
